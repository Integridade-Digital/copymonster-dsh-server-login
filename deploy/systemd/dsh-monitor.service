[Unit]
Description=CopyMonster DSH host health probe
Documentation=https://github.com/Integridade-Digital/copymonster-dsh-server-login
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/copymonster/dsh-server-login/scripts/monitor.mjs
Environment=DSH_MONITOR_DISK_PCT=90
Environment=DSH_MONITOR_MEMORY_PCT=90
Environment=DSH_MONITOR_5XX_LIMIT=20
Environment=DSH_MONITOR_WINDOW_MINUTES=5
# Set to a JSON webhook (Telegram/Slack) to receive alerts out of band.
#Environment=DSH_ALERT_WEBHOOK=https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-monitor
