# CopyMonster DSH Orchestrator Production Environment (Port 3081)
# Copy to /etc/copymonster-dsh/orchestrator.env and set chmod 600

# Network & Host
DSH_SERVER_LOGIN_PORT=3081
DSH_SERVER_LOGIN_BASE_DOMAIN=app.copymonster.co
DSH_SERVER_LOGIN_COOKIE_DOMAIN=.app.copymonster.co
DSH_SERVER_LOGIN_SECURE_COOKIES=true

# Security & Linux Hard Isolation
DSH_SERVER_LOGIN_ISOLATION_MODE=account
DSH_SERVER_LOGIN_PORT_GUARD=true
DSH_SERVER_LOGIN_BASE_UID=100000
DSH_SERVER_LOGIN_DATA_ROOT=/var/lib/copymonster-dsh

# DSH Executable Binary
# Point to your global node/dsh or wrapper installed outside of /root
DSH_SERVER_LOGIN_DSH_BIN=/usr/local/bin/dsh

# Secrets (Generate strong random values)
DSH_SERVER_LOGIN_SECRET=replace_with_64_char_hex_secret
SUPABASE_JWT_SECRET=replace_with_supabase_project_jwt_secret

# Session TTL (7 days in seconds)
DSH_SERVER_LOGIN_SESSION_TTL=604800
